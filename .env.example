# HL Liquidation Hunter - Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Hyperliquid API (no auth needed for public endpoints, but kept for future use)
# HL_API_URL=https://api.hyperliquid.xyz
# HL_WS_URL=wss://api.hyperliquid.xyz/ws

# Rate limiting
# HL_RATE_BUDGET=1000          # max weight/min (hard limit 1200, use 1000 safe)

# Storage
# DATA_DIR=data/raw            # where parquet files land

# Logging
# LOG_LEVEL=INFO
